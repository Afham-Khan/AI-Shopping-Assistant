NODE_ENV=development
PORT=5000

# PostgreSQL (single database for commerce + AI)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cartwise
# Hosted database (Neon): paste the connection string and it replaces the DB_* values above.
# Do not keep it in this file on a laptop that also runs `npm test`; set it in the PowerShell session instead
# (tests ignore DATABASE_URL on purpose). See docs/DEPLOYMENT.md.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require
# DB_SSL=true            # force TLS on/off; by default it follows sslmode=require in DATABASE_URL
# DB_POOL_MAX=5          # connections per process (free database tiers allow only a few)

# Hosting (free tier)
# CORS_ORIGINS: websites allowed to call the API from a browser, comma separated; "*" in an entry matches one
# subdomain (previews). Not set = everything allowed in development, nothing cross-origin in production.
# CORS_ORIGINS=https://zelora.vercel.app,https://*.vercel.app
# IMAGE_MODE: cdn = keep the original cdn.dummyjson.com image URLs (default in production / with DATABASE_URL);
#             local = images cached by `npm run images:cache` and served from /uploads (offline laptop demos)
# IMAGE_MODE=cdn
# AI_VISUAL=off          # off = skip the CLIP model (Snap & Find returns 503, saves ~500 MB RAM); default on
# ADMIN_PASSWORD=       # password of admin@zelora.app when seeding a hosted database (never left at the public default)

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# Public URL used to build image links (Android emulator reaches the host via 10.0.2.2)
PUBLIC_BASE_URL=

# Email (optional). Without SMTP the OTP is printed to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cartwise <no-reply@cartwise.app>"

# AI — works fully offline by default. An LLM key only upgrades reply wording.
# AI_EMBEDDINGS: neural (MiniLM via transformers.js, cached in .cache/) | tfidf (pure-JS TF-IDF + LSA)
AI_EMBEDDINGS=neural
# LLM_PROVIDER: none | gemini | groq. Default "none": everything (search, chat, compare, gifts, explainer, FAQ) is local.
# When enabled, the LLM is used for exactly two things, both guarded:
#   1. polishing the wording of local replies from verified facts (invented numbers are rejected -> local reply kept)
#   2. answering out-of-scope / general questions ("what is the capital of France") in Zel's persona:
#      max 2 sentences, no products/prices/vendor names, redirects to shopping. Any failure -> offline reply.
# Product facts, prices, delivery and policies ALWAYS come from the local engine, never from the LLM.
#
# Free Gemini setup (no billing needed):
#   1. Open https://aistudio.google.com/apikey, sign in with a Google account, click "Create API key".
#   2. Paste it below as GEMINI_API_KEY and set LLM_PROVIDER=gemini.
#   3. Keep GEMINI_MODEL=gemini-3.5-flash-lite (gemini-2.5-flash-lite is no longer offered to new keys). Restart the API.
#   Check GET /api/v1/ai/insights -> llm.enabled = true, llm.usedToday counts calls.
# The test suite always forces LLM_PROVIDER=none (test/setup.js), and the probe script does too unless run with --llm.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Free-tier safety guard (applies to any provider). Over a limit -> the local reply is used, never an error.
LLM_RATE_PER_MIN=12          # token bucket: max LLM calls per minute
LLM_DAILY_LIMIT=800          # max LLM calls per UTC day
LLM_CACHE_SIZE=200           # LRU cache: same prompt + facts -> cached answer, no call
LLM_CACHE_TTL_MS=21600000    # cache entries live 6 hours
LLM_BREAKER_THRESHOLD=3      # circuit breaker: after 3 failures in a row...
LLM_BREAKER_COOLDOWN_MS=300000  # ...skip the LLM for 5 minutes
