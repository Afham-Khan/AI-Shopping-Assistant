NODE_ENV=development
PORT=5000

# PostgreSQL (single database for commerce + AI)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cartwise

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# Public URL used to build image links (Android emulator reaches the host via 10.0.2.2)
PUBLIC_BASE_URL=

# Email (optional). Without SMTP the OTP is printed to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cartwise <no-reply@cartwise.app>"

# AI — works fully offline by default. An LLM key only upgrades reply wording.
# AI_EMBEDDINGS: neural (MiniLM via transformers.js, cached in .cache/) | tfidf (pure-JS TF-IDF + LSA)
AI_EMBEDDINGS=neural
# LLM_PROVIDER: none | gemini | groq. Default "none": everything (search, chat, compare, gifts, explainer) is local.
# The LLM only rewrites chat wording from verified facts; numbers it invents are rejected and the local reply is kept.
#
# Free Gemini setup (no billing needed):
#   1. Open https://aistudio.google.com/apikey, sign in with a Google account, click "Create API key".
#   2. Paste it below as GEMINI_API_KEY and set LLM_PROVIDER=gemini.
#   3. Keep GEMINI_MODEL=gemini-2.5-flash-lite (fast, generous free tier). Restart the API.
#   Check GET /api/v1/ai/insights -> llm.enabled = true, llm.usedToday counts calls.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Free-tier safety guard (applies to any provider). Over a limit -> the local reply is used, never an error.
LLM_RATE_PER_MIN=12          # token bucket: max LLM calls per minute
LLM_DAILY_LIMIT=800          # max LLM calls per UTC day
LLM_CACHE_SIZE=200           # LRU cache: same prompt + facts -> cached answer, no call
LLM_CACHE_TTL_MS=21600000    # cache entries live 6 hours
LLM_BREAKER_THRESHOLD=3      # circuit breaker: after 3 failures in a row...
LLM_BREAKER_COOLDOWN_MS=300000  # ...skip the LLM for 5 minutes
