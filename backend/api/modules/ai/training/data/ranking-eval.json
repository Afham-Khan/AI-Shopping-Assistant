{
  "schema": {
    "about": "Golden set for recommendation relevance. Run: npm run ai:eval. Each query goes through the real chat pipeline and the top cards are checked against the expectations below. See docs/AI_TRAINING.md -> 'Improving recommendations (no coding needed)'.",
    "fields": {
      "id": "unique short name, e.g. shoes-running-1",
      "q": "exactly what the shopper typed (typos and Roman Urdu welcome)",
      "group": "department or use-case label, only used to group the report",
      "expectCategories": "list of category slugs every top-3 card must belong to, or null for 'any category' (gifts, mixed)",
      "mustMatchAny": "a card is RELEVANT only if its title / category / colour / brand / keywords / tags / spec values contain at least one of these words (word start match: 'sneaker' also matches 'sneakers'). [] = no extra requirement",
      "mustNotMatch": "a top-3 card whose title / category / keywords / tags contain any of these words is a VIOLATION (e.g. heels for running)",
      "color": "colour family the cards must have (listed colour or a colour in the title like 'Red & Black'), or null",
      "gender": "'men' or 'women': no top-3 card may be for the other gender, or null",
      "minPrice": "number in PKR or null",
      "maxPrice": "number in PKR or null",
      "brand": "brand name every card must have, or null",
      "minHits@3": "how many of the top 3 cards must be relevant (automatically lowered when the catalogue has fewer matching products)",
      "followUps": "optional list of next messages, sent one by one only while Zel has shown no products yet (e.g. answers to 'What budget?' in the gift flow)",
      "knownFailure": "optional true: the query fails today for a known reason (e.g. the catalogue has no such product) and is being worked on. It still shows in the report, but does not fail 'npm test'",
      "note": "optional: why this query is in the set"
    },
    "passRule": "PASS = enough relevant cards in the top 3 AND no avoidable constraint violation in the top 3 (category, gender, budget, brand, colour, mustNotMatch) AND the reply's top pick is the first card. A violation is 'avoidable' when the catalogue had a product that met every constraint for that slot (and, if the card is the asked-for kind, a compliant product of that kind). 'npm test' fails when any query without knownFailure fails."
  },
