# Settings for running the API against a HOSTED database. Copy this file to backend/.env.production (it is git-ignored,
# never commit the real one) and fill it in, then start with:  npm run start:prod
# The same names go into the environment settings of any host (Render, Docker, ...). Anything not listed here still
# comes from backend/.env, for example LLM_PROVIDER and GEMINI_API_KEY. See docs/DEPLOYMENT.md.

NODE_ENV=production
PORT=5000

# Neon connection string (Neon dashboard > Connect). Keep sslmode=require at the end.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Two different random values of 24+ characters; the API refuses to start in production with the "change-me" ones.
# Make each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The website allowed to call the API from a browser (your Vercel address, no slash at the end). Several: comma separated.
CORS_ORIGINS=https://your-project.vercel.app

# Product images stay on the public CDN (the seed in deploy:init already did this).
IMAGE_MODE=cdn

# AI. neural = MiniLM embeddings (about 170 MB RAM). AI_VISUAL=on keeps Snap & Find (CLIP, about 350-500 MB RAM):
# fine on a laptop, use off on a 512 MB host (Snap & Find then answers "unavailable", everything else works).
AI_EMBEDDINGS=neural
AI_VISUAL=on

# Where the models are cached (default backend/.cache). Azure App Service: /home/.cache (persistent storage, the
# models download once and survive restarts). AI_VISUAL_WARMUP=on loads CLIP right after boot instead of on the first
# Snap & Find request. See docs/DEPLOYMENT_AZURE.md.
# AI_CACHE_DIR=/home/.cache
# AI_VISUAL_WARMUP=on
