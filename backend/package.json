{
  "name": "cartwise-api",
  "version": "1.0.0",
  "description": "Cartwise - AI shopping assistant API",
  "main": "server.js",
  "scripts": {
    "db:start": "pg_ctl -D \"%USERPROFILE%/.cartwise/pgdata\" -l \"%USERPROFILE%/.cartwise/pg.log\" start",
    "start": "node server.js",
    "start:prod": "node --env-file=.env.production server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/createDatabase.js",
    "db:migrate": "knex migrate:latest",
    "db:seed": "node scripts/seed.js",
    "images:cache": "node scripts/cacheImages.js",
    "ai:train": "node api/modules/ai/training/train.js",
    "ai:index": "node api/modules/ai/training/buildIndex.js",
    "ai:prefetch": "node scripts/prefetchModels.js",
    "deploy:init": "node scripts/deployInit.js",
    "demo:price-drop": "node scripts/demoPriceDrop.js",
    "setup": "npm run db:create && npm run db:migrate && npm run db:seed && npm run images:cache && npm run ai:train && npm run ai:index",
    "test": "mocha --timeout 30000 --exit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "module-alias": "^2.3.5",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "mocha": "^12.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
