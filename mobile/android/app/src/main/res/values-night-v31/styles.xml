<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same splash in dark mode (the launch screen keeps the light wash, like values-night/styles.xml).
         A values-night folder would otherwise win over values-v31 on dark Android 12+ devices. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#F3F5FD</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#2563EB</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
