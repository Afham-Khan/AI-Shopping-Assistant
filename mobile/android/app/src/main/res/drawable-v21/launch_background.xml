<?xml version="1.0" encoding="utf-8"?>
<!-- Zelora launch screen: the page wash color. Flutter's SplashScreen then
     takes over with the animated Z-bag mark. (No bitmap here: on API 26+
     @mipmap/ic_launcher is an adaptive-icon XML, which <bitmap> can't load.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#EEF1FB" />
    </item>
</layer-list>